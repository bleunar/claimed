# ============================================================
# SENSITIVE VARIABLES (Development Only)
# In production, these are loaded from Docker secrets.
# Do NOT commit actual values to version control.
# ============================================================

SECRET_KEY=dev_secret_key
JWT_SECRET_KEY=dev_jwt_secret
MYSQL_PASSWORD=
MAIL_PASSWORD=abcd efgh ijkl
DEFAULT_ADMIN_PASSWORD=admin_password

# ============================================================
# NON-SENSITIVE VARIABLES
# These are used in both development and production.
# ============================================================

# App
APP_ENV=development
LOG_MODE=MAX # MAX | MIN

# CORS
CORS_ORIGINS="https://example.com"

# JWT
JWT_COOKIE_DOMAIN=  # Set to '.example.com' in production for cross-subdomain auth

# Database
MYSQL_HOST=localhost
MYSQL_USER=claimed
MYSQL_DB=claimed

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com

# Default Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
